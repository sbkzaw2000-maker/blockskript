{
  "name": "BlockSkript",
  "version": "26.8.8",
  "description": "BlockSkript - kreator skript do minecraft",
  "main": "main.js",
  "author": {
    "name": "Sebbeek"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win nsis",
    "build:linux": "electron-builder --linux AppImage",
    "dist": "electron-builder",
    "release": "node release.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "pl.tornadocode.blockskript",
    "productName": "BlockSkript",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "BlockSkript-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BlockSkript"
    },
    "publish": {
      "provider": "github",
      "owner": "sbkzaw2000-maker",
      "repo": "blockskript",
      "releaseType": "release"
    }
  }
}
